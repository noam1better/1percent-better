GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
INBOX_DIR=./inbox
OUTPUT_DIR=./output
DB_PATH=./data/accounting.db
WEBHOOK_PORT=3001
WEBHOOK_SECRET=your_secret_token_here
# Output format — comma-separated list: csv | json | accounting-software-xml | webhook
OUTPUT_FORMAT=csv,webhook
# Exporter directories
CSV_DIR=./output/csv
JSON_DIR=./output/json
XML_DIR=./output/xml
# Webhook exporter
EXPORT_WEBHOOK_URL=https://your-accounting-software.com/api/webhook
EXPORT_WEBHOOK_SECRET=your_export_secret
EXPORT_WEBHOOK_TIMEOUT_MS=10000
LOG_LEVEL=info
