rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── USER PROFILES ──────────────────────────────────
    // Read/write restricted to the authenticated owner only.
    // uid field, if present, must equal the document key (prevents
    // a user from planting a uid that impersonates another account).
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                   && (!('uid' in request.resource.data)
                       || request.resource.data.uid == uid);
      allow update: if isOwner(uid)
                   && (!('uid' in request.resource.data)
                       || request.resource.data.uid == uid);
      allow delete: if isOwner(uid);

      // Daily activity sub-collection.
      // Date key must be YYYY-MM-DD to prevent arbitrary key injection.
      match /activity/{date} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid)
                    && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      // My Tasks sub-collection — the user's own one-off tasks.
      // Owner-only. Shape: { text, done, createdDate, doneDate, createdAt }.
      // Dates are local YYYY-MM-DD keys; doneDate is null while open.
      match /tasks/{taskId} {
        function validTask(d) {
          return d.keys().hasOnly(['text', 'done', 'createdDate', 'doneDate', 'createdAt'])
              && d.text is string && d.text.size() > 0 && d.text.size() <= 200
              && d.done is bool
              && d.createdDate is string && d.createdDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && (d.doneDate == null
                  || (d.doneDate is string && d.doneDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
        }
        allow read, delete: if isOwner(uid);
        allow create:       if isOwner(uid) && validTask(request.resource.data);
        allow update:       if isOwner(uid) && validTask(request.resource.data)
                            && request.resource.data.createdDate == resource.data.createdDate;
      }
    }

    // ── POSTS (Community Feed) ──────────────────────────
    // Any signed-in user can read.
    // Create: uid must equal caller, caption is a string ≤500 chars.
    // Update: caller must own the post, uid is immutable, caption validated.
    // Delete: caller must own the post.
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.caption is string
                   && request.resource.data.caption.size() <= 500;

      allow update: if isSignedIn()
                   && resource.data.uid == request.auth.uid
                   && request.resource.data.uid == resource.data.uid
                   && request.resource.data.caption is string
                   && request.resource.data.caption.size() <= 500;

      allow delete: if isSignedIn()
                   && resource.data.uid == request.auth.uid;
    }

    // ── FOCUS TRIGGER PROFILES ─────────────────────────
    // Owner-only. Field-level validation:
    //   xp must be a non-negative number if present.
    //   name must be a string ≤50 chars if present.
    //   triggers must be a list if present.
    match /focusTriggers/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                  && (!('xp'       in request.resource.data) || (request.resource.data.xp is number       && request.resource.data.xp >= 0))
                  && (!('name'     in request.resource.data) || (request.resource.data.name is string     && request.resource.data.name.size() <= 50))
                  && (!('triggers' in request.resource.data) || request.resource.data.triggers is list)
                  && (!('tier'     in request.resource.data) || request.resource.data.tier == 'free');
    }

    // ── LEADERBOARD (public XP + name only) ───────────
    // Any signed-in user can read (community feature).
    // Write: owner only; name ≤50 chars, xp non-negative number.
    match /leaderboard/{uid} {
      allow read:  if isSignedIn();
      allow write: if isOwner(uid)
                  && request.resource.data.xp is number
                  && request.resource.data.xp >= 0
                  && request.resource.data.name is string
                  && request.resource.data.name.size() <= 50;
    }

    // ── CUSTOM AI PATHS ────────────────────────────────
    // Owner-only. Stores AI-generated 30-day personal program + progress.
    // questionnaire.goal must be a non-empty string if present.
    // progress.currentDay must be a number in [1,30] if present.
    match /userPaths/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                  && (!('questionnaire' in request.resource.data) || request.resource.data.questionnaire is map)
                  && (!('progress' in request.resource.data)      || request.resource.data.progress is map)
                  && (!('status' in request.resource.data)        || request.resource.data.status in ['active','completed','pending','reset']);

      // Path archive — previous 30-day programs stored per-uid.
      match /history/{archiveId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    // ── PROOF OF ACTION ────────────────────────────────
    // Owner-only. Immutable completion records; no overwrite after save.
    // text capped at 1000 chars; imageUrl must be a string if present.
    match /proofs/{uid}/entries/{entryId} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                   && (!('text'     in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
                   && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string);
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // ── SQUADS ─────────────────────────────────────────
    // createdBy, createdAt, and inviteCode are immutable after creation.
    // Two legitimate update paths:
    //   (a) Join — caller not yet a member, adds only their own uid to memberUids
    //       (arrayUnion semantics: existing members preserved, size +1 max).
    //   (b) Member update — caller is an existing member, memberUids stays unchanged
    //       (covers telegramChatId writes and members map updates).
    // Any member can update non-uid fields (name, telegramChatId) — acceptable;
    // the high-severity risk (arbitrary memberUids overwrite) is blocked.
    match /squads/{squadId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn()
                   && request.resource.data.createdBy == request.auth.uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 40;
      allow update: if isSignedIn()
                   // Immutable core fields
                   && request.resource.data.createdBy  == resource.data.createdBy
                   && request.resource.data.createdAt  == resource.data.createdAt
                   && request.resource.data.inviteCode == resource.data.inviteCode
                   && (
                     // (a) Join: caller is not yet a member, adds only their own uid
                     (!(request.auth.uid in resource.data.memberUids)
                      && request.auth.uid in request.resource.data.memberUids
                      && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                      && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1)
                     ||
                     // (b) Existing member update: memberUids must not change
                     (request.auth.uid in resource.data.memberUids
                      && request.resource.data.memberUids == resource.data.memberUids)
                   );
    }

    // ── WEEKLY REPS (readable by any signed-in user for squad leaderboard) ──
    match /weeklyReps/{uid} {
      allow read:  if isSignedIn();
      allow write: if isOwner(uid)
                  && request.resource.data.totalReps is number
                  && request.resource.data.totalReps >= 0;
    }

    // ── HEAD-TO-HEAD CHALLENGES ────────────────────────
    match /challenges/{challengeId} {
      allow read:   if isSignedIn()
                   && (resource.data.challenger == request.auth.uid
                       || resource.data.challenged == request.auth.uid);
      allow create: if isSignedIn()
                   && request.resource.data.challenger == request.auth.uid;
      allow update: if isSignedIn()
                   && (resource.data.challenger == request.auth.uid
                       || resource.data.challenged == request.auth.uid);
    }

    // ── NUDGE RESPONSES ────────────────────────────────
    // Written by notificationService.saveNudgeResponse as {uid}_{YYYY-MM-DD}.
    // Document must carry a uid field matching the caller; read is also uid-scoped.
    match /nudgeResponses/{docId} {
      allow write: if isSignedIn()
                  && request.resource.data.uid == request.auth.uid;
      allow read:  if isSignedIn()
                  && resource.data.uid == request.auth.uid;
    }

    // ── PRO WAITLIST ───────────────────────────────────
    // Owner can read their own entry; write requires valid email string ≤254 chars.
    match /waitlist/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                  && request.resource.data.email is string
                  && request.resource.data.email.size() > 0
                  && request.resource.data.email.size() <= 254;
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
