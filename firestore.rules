rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USER PROFILES ──────────────────────────────────
    // Each user can only read/write their own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Activity sub-collection
      match /activity/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // AI weekly review sub-collection
      // - Owner can read their own reviews (offline persistence relies on this).
      // - Writes are server-only (Cloud Function uses admin SDK which bypasses
      //   rules); we deny client writes so a malicious client can't fabricate
      //   reviews or burn through the API quota.
      match /aiReviews/{weekId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── POSTS (Community Feed) ──────────────────────────
    // Anyone signed in can read posts
    // Only the post owner can write/delete their own post
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 500;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
