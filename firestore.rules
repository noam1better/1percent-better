rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── USER PROFILES ──────────────────────────────────
    // Read/write restricted to the authenticated owner only.
    // uid field, if present, must equal the document key (prevents
    // a user from planting a uid that impersonates another account).
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                   && (!('uid' in request.resource.data)
                       || request.resource.data.uid == uid);
      allow update: if isOwner(uid)
                   && (!('uid' in request.resource.data)
                       || request.resource.data.uid == uid);
      allow delete: if isOwner(uid);

      // Daily activity sub-collection.
      // Date key must be YYYY-MM-DD to prevent arbitrary key injection.
      match /activity/{date} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid)
                    && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
    }

    // ── POSTS (Community Feed) ──────────────────────────
    // Any signed-in user can read.
    // Create: uid must equal caller, caption is a string ≤500 chars.
    // Update: caller must own the post, uid is immutable, caption validated.
    // Delete: caller must own the post.
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.caption is string
                   && request.resource.data.caption.size() <= 500;

      allow update: if isSignedIn()
                   && resource.data.uid == request.auth.uid
                   && request.resource.data.uid == resource.data.uid
                   && request.resource.data.caption is string
                   && request.resource.data.caption.size() <= 500;

      allow delete: if isSignedIn()
                   && resource.data.uid == request.auth.uid;
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
