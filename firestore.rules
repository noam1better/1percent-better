rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USER PROFILES ──────────────────────────────────
    // Each user can only read/write their own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Activity sub-collection
      match /activity/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── POSTS (Community Feed) ──────────────────────────
    // Anyone signed in can read posts
    // Only the post owner can write/delete their own post
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 500;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
