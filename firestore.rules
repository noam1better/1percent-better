rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── USER PROFILES ──────────────────────────────────
    // Read/write restricted to the authenticated owner only.
    // uid field, if present, must equal the document key (prevents
    // a user from planting a uid that impersonates another account).
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                   && (!('uid' in request.resource.data)
                       || request.resource.data.uid == uid);
      allow update: if isOwner(uid)
                   && (!('uid' in request.resource.data)
                       || request.resource.data.uid == uid);
      allow delete: if isOwner(uid);

      // Daily activity sub-collection.
      // Date key must be YYYY-MM-DD to prevent arbitrary key injection.
      match /activity/{date} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid)
                    && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
    }

    // ── POSTS (Community Feed) ──────────────────────────
    // Any signed-in user can read.
    // Create: uid must equal caller, caption is a string ≤500 chars.
    // Update: caller must own the post, uid is immutable, caption validated.
    // Delete: caller must own the post.
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.caption is string
                   && request.resource.data.caption.size() <= 500;

      allow update: if isSignedIn()
                   && resource.data.uid == request.auth.uid
                   && request.resource.data.uid == resource.data.uid
                   && request.resource.data.caption is string
                   && request.resource.data.caption.size() <= 500;

      allow delete: if isSignedIn()
                   && resource.data.uid == request.auth.uid;
    }

    // ── FOCUS TRIGGER PROFILES ─────────────────────────
    // Owner-only. Field-level validation:
    //   xp must be a non-negative number if present.
    //   name must be a string ≤50 chars if present.
    //   triggers must be a list if present.
    match /focusTriggers/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                  && (!('xp'       in request.resource.data) || (request.resource.data.xp is number       && request.resource.data.xp >= 0))
                  && (!('name'     in request.resource.data) || (request.resource.data.name is string     && request.resource.data.name.size() <= 50))
                  && (!('triggers' in request.resource.data) || request.resource.data.triggers is list);
    }

    // ── LEADERBOARD (public XP + name only) ───────────
    // Any signed-in user can read (community feature).
    // Write: owner only; name ≤50 chars, xp non-negative number.
    match /leaderboard/{uid} {
      allow read:  if isSignedIn();
      allow write: if isOwner(uid)
                  && request.resource.data.xp is number
                  && request.resource.data.xp >= 0
                  && request.resource.data.name is string
                  && request.resource.data.name.size() <= 50;
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
