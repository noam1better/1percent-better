{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "**/__tests__/**", "jest.config.js"]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "storage.rules",
      "**/node_modules/**",
      "my-new-idea/**",
      "functions/**",
      ".git/**",
      ".firebase/**",
      ".agents/**",
      ".claude/**",
      "remotion-progress/**",
      "ai-video-speedrun/**",
      "tests/**",
      "deploy_*.sh",
      "*.skill",
      "skills-lock.json",
      "DEPLOY.md",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/boxing-coach/**",
        "destination": "/boxing-coach/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/boxing-coach/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options",  "value": "nosniff" },
          { "key": "X-Frame-Options",          "value": "DENY" },
          { "key": "X-XSS-Protection",         "value": "1; mode=block" },
          { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy",       "value": "camera=(self), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy",  "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
