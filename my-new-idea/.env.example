# ════════════════════════════════════════════════════════════════════
# BusinessBuilder AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real keys to git.
# ════════════════════════════════════════════════════════════════════

# ── Platform Contact ──────────────────────────────────────────────────
# Your WhatsApp number (digits only, with country code).
# Used in lead-capture buttons on the demo/preview page.
# Example: 972501234567  (Israel +972, no dashes or spaces)
VITE_CONTACT_WHATSAPP=

# ── AI Provider (Advisor AI chat) ────────────────────────────────────
# Provider cascade: OpenAI → Claude → smart mock (no key = mock mode).
# Set ONE key to enable real AI. Mock mode works fine for demo.
#
# ⚠ SECURITY WARNING: VITE_ keys are bundled into the browser JS.
#   Anyone can extract them from the built assets. Use a backend proxy
#   for production if you want to keep keys private.
#
# OpenAI — get key: platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude — get key: console.anthropic.com/settings/keys
# Claude allows direct browser access via the dangerous-direct-browser-access header.
VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── AI Website Generator ──────────────────────────────────────────────
# Separate config for the website generation flow (legacy path).
# Default is 'mock' — set to 'openai', 'claude', 'gemini', or 'ollama'.
VITE_AI_PROVIDER=mock

# Google Gemini — get key: aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# Ollama (local LLM — no API key needed)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1:8b

# ── Firebase (optional — for auth and lead storage) ───────────────────
# Leave blank to run without Firebase (localStorage mode).
# Get values from: console.firebase.google.com → Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Stripe (optional — not active in current build) ───────────────────
# Required only when payment flows are enabled.
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_AGENCY_PRICE_ID=
