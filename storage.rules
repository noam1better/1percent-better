rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ── PROOF PHOTOS ────────────────────────────────────
    // Only the owner can upload/read/delete their own proofs.
    // No overwrite — each proof is an immutable timestamped record.
    match /proofs/{uid}/{fileName} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                   && request.resource.size < 10 * 1024 * 1024
                   && isImage()
                   && fileName.size() <= 200;
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // ── PROFILE AVATARS ─────────────────────────────────
    // Any signed-in user can read (avatars appear in the community feed).
    // Only the owner can write; overwrites are intentional (stable path).
    match /avatars/{uid}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isOwner(uid)
                   && request.resource.size < 2 * 1024 * 1024
                   && isImage()
                   && fileName.size() <= 200;
      allow delete: if isOwner(uid);
    }

    // ── DENY EVERYTHING ELSE ───────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
